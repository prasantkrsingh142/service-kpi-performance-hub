# Service KPI Performance Hub - build settings
# Copy to .env, edit, then run:  python build.py

# Market for the Financial Impact page (built-in 2025 baseline is NAM only)
MARKET=NAM

# Labor rate in EUR per hour
LABOR_RATE=189.7

# Full-year (FY) EUR labor-savings targets
# Source: 2026 MR SSD RR & FVF Savings SEP YTD (1).xlsx, sheet "2026 targets" (C6, C4, C5)
TARGET_RR=433339.33
TARGET_FVF_WITHOUT_PARTS=102253.92
TARGET_FVF_WITH_PARTS=342452.17
